<Window x:Class="PodcastHelper.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastHelper.App.Controls" Title="About PodcastHelper" Width="760" Height="590" MinWidth="660" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F1EDDF" Foreground="#29343A" FontFamily="Segoe UI" FontSize="15">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border Background="{StaticResource IvoryCap}" BorderBrush="#9E9D8C" BorderThickness="1" CornerRadius="6" Padding="24,25" Margin="0,0,0,23"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource AmberCap}" CornerRadius="5" Width="46" Height="46" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource BadgeTilt}" Effect="{StaticResource BadgeShadow}"><controls:StudioIcon Kind="heart" Width="26" Height="26" /></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="PodcastHelper" FontSize="32" FontWeight="SemiBold" /><TextBlock Margin="0,8,0,0" Foreground="#5A655F"><Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding Build}" Foreground="#756B54" FontFamily="Consolas" FontSize="13" Margin="0,5,0,20" /><TextBlock Text="Made with love by Caspian" FontSize="17" /><TextBlock Text="© 2026 Caspian" Foreground="#5A655F" Margin="0,6,0,0" /></StackPanel>
            </Grid></Border>
            <TextBlock Text="Distributed under MIT license" FontWeight="SemiBold" Margin="0,0,0,12" />
            <WrapPanel Margin="0,0,0,18"><Button Content="MIT license" Command="{Binding MitCommand}" Style="{StaticResource PaperKey}" Margin="0,0,12,8" /><Button Content="Local LICENSE" Command="{Binding LicenseCommand}" Style="{StaticResource PaperKey}" Margin="0,0,0,8" /></WrapPanel>
            <WrapPanel><Button Content="Third-party licenses" Command="{Binding ThirdPartyCommand}" Style="{StaticResource PaperKey}" Margin="0,0,12,8" /><Button Content="Copy diagnostic info" Command="{Binding CopyCommand}" Style="{StaticResource PaperKey}" Margin="0,0,0,8" /></WrapPanel>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" Foreground="#786039" TextWrapping="Wrap" Margin="0,0,0,12" /><DockPanel><Button Content="Clone me on GitHub" Command="{Binding GitHubCommand}" Style="{StaticResource PaperKey}" HorizontalAlignment="Left" /><Button Content="Close" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryKey}" HorizontalAlignment="Right" MinWidth="105" /></DockPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="{Binding ShowMouseHint, Converter={StaticResource Bool}}"><controls:StudioIcon Kind="mouse" Foreground="#6B726B" Width="14" Height="16" Margin="0,0,6,0" /><TextBlock Text="Use mouse" Foreground="#6B726B" FontSize="12" /></StackPanel></StackPanel>
    </Grid>
</Window>
