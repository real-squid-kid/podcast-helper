<Window x:Class="PodcastHelper.App.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover session" Width="740" Height="700" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F4F4" Foreground="#202225">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#9C251C" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ClosedInterval}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Check the times, current segment and recording state. Correct any estimates, then choose Recover session below."
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Camera activity is not verified. Enter times in seconds; minutes and seconds are shown beside each field."
                       TextWrapping="Wrap" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Session Time" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SessionSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" IsEnabled="{Binding HasStarted}" />
                <TextBlock Grid.Column="2" Text="{Binding SessionReadable}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,10" Foreground="#555555" />
                <TextBlock Grid.Row="1" Text="Current segment" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Segments}" DisplayMemberPath="Name" SelectedValuePath="Index"
                          SelectedValue="{Binding SelectedSegmentIndex}" Padding="6" Margin="0,0,0,10" IsEnabled="{Binding HasStarted}" />
                <TextBlock Grid.Row="2" Text="Segment active time" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SegmentSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" IsEnabled="{Binding HasStarted}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SegmentReadable}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,10" Foreground="#555555" />
                <TextBlock Grid.Row="3" Text="Take Time" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TakeSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,4" IsEnabled="{Binding HasStarted}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TakeReadable}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,4" Foreground="#555555" />
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TakeLabel}" Foreground="#555555" Margin="0,0,0,12" />
                <TextBlock Grid.Row="5" Text="Recording state" VerticalAlignment="Center" />
                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedStatus}" Padding="6" IsEnabled="{Binding HasStarted}" />
            </Grid>
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,18,0,8" />
            <TextBlock Text="Recover session applies these values and restores the selected recording state. Start anew archives this session without resuming it. Saved events will not be deleted."
                       TextWrapping="Wrap" Margin="0,0,0,14" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#9C251C" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start anew" Command="{Binding StartAnewCommand}" Padding="16,8" Margin="0,0,12,0" />
                <Button Content="Recover session" Command="{Binding RecoverCommand}" Padding="16,8" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="🖱 Use mouse" Visibility="{Binding ShowMouseHint, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Right" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
