<Window x:Class="PodcastHelper.App.FolderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastHelper.App.Controls"
        Title="Export folder" Width="800" Height="650" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F1EDDF" Foreground="#29343A" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><Border RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource BadgeTilt}" Effect="{StaticResource BadgeShadow}" Width="46" Height="46" VerticalAlignment="Top" Background="{StaticResource AmberCap}" CornerRadius="5" BorderBrush="#B79A64" BorderThickness="1" Margin="0,0,16,0"><controls:StudioIcon Kind="folder" Width="27" Height="27" /></Border><TextBlock Text="Export folder" Style="{StaticResource DialogTitle}" Margin="0,3,0,0" /></DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button Content="Drives" Command="{Binding DrivesCommand}" Style="{StaticResource PaperKey}" Margin="0,0,10,0" Padding="12,8" /><Button Command="{Binding UpCommand}" Style="{StaticResource PaperKey}" Margin="0,0,10,0" Padding="8" ToolTip="Parent folder" AutomationProperties.Name="Parent folder"><controls:StudioIcon Kind="up" Width="22" Height="22" /></Button><Button DockPanel.Dock="Right" Command="{Binding GoCommand}" Style="{StaticResource PaperKey}" Margin="10,0,0,0" Padding="8" ToolTip="Open entered location" AutomationProperties.Name="Open entered location"><controls:StudioIcon Kind="next" Width="22" Height="22" /></Button><TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="Folder location" /></DockPanel>
        <ListBox x:Name="FolderList" Grid.Row="2" ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" IsEnabled="{Binding NotBusy}" Background="#FAF6EC" BorderBrush="#C8C6B8" Padding="10" HorizontalContentAlignment="Stretch" MouseDoubleClick="OpenFolder">
            <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,10"><controls:StudioIcon Kind="folder" Foreground="#9B783C" Width="22" Height="22" Margin="0,0,12,0" /><TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="Wrap" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#9A4935" Margin="0,0,0,10" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsEnabled="{Binding NotBusy}" Command="{Binding CancelCommand}" Style="{StaticResource PaperKey}" Margin="0,0,12,0" /><Button Content="Use this folder" IsEnabled="{Binding CanChoose}" Command="{Binding ChooseCommand}" Style="{StaticResource PrimaryKey}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="{Binding ShowMouseHint, Converter={StaticResource Bool}}"><controls:StudioIcon Kind="mouse" Foreground="#6B726B" Width="14" Height="16" Margin="0,0,6,0" /><TextBlock Text="Use mouse" Foreground="#6B726B" FontSize="12" /></StackPanel></StackPanel>
    </Grid>
</Window>
