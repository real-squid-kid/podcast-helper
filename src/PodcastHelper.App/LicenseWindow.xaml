<Window x:Class="PodcastHelper.App.LicenseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastHelper.App.Controls" Title="{Binding Heading}" Width="1060" Height="760" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterOwner" Background="#F1EDDF" Foreground="#29343A" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="65" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding Heading}" Style="{StaticResource DialogTitle}" />
        <DockPanel Grid.Row="1"><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Visibility="{Binding HasChoices, Converter={StaticResource Bool}}" Width="245" Margin="0,0,20,0" Background="#E5E1D3" BorderBrush="#C5C4B4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,12"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Version}" Foreground="#776A50" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,7" /><TextBlock Grid.Row="1" Text="{Binding Selected.Owner}" TextWrapping="Wrap" Foreground="#5E6B61" Margin="0,0,0,14" /><TextBox Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Padding="16" BorderBrush="#C6C5B8" Background="#FBF8F0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="License text" /></Grid>
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding Message}" Foreground="#9B4E36" TextWrapping="Wrap" Margin="0,0,0,10" /><Button Content="Close" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryKey}" HorizontalAlignment="Right" MinWidth="105" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="{Binding ShowMouseHint, Converter={StaticResource Bool}}"><controls:StudioIcon Kind="mouse" Foreground="#6B726B" Width="14" Height="16" Margin="0,0,6,0" /><TextBlock Text="Use mouse" Foreground="#6B726B" FontSize="12" /></StackPanel></StackPanel>
    </Grid>
</Window>
