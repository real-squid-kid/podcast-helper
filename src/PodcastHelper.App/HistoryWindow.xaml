<Window x:Class="PodcastHelper.App.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastHelper.App.Controls"
        Title="Session history" Width="1120" Height="850" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F1EDDF" Foreground="#29343A" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource PaperKey}" Foreground="#35433E" Width="40" Height="40" Padding="8" ToolTip="Refresh history" AutomationProperties.Name="Refresh history"><controls:StudioIcon Kind="recover" /></Button>
            <Border RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource BadgeTilt}" Effect="{StaticResource BadgeShadow}" Width="46" Height="46" VerticalAlignment="Top" Background="{StaticResource AmberCap}" CornerRadius="5" BorderBrush="#B79A64" BorderThickness="1" Margin="0,0,16,0"><controls:StudioIcon Kind="history" Width="27" Height="27" /></Border><TextBlock Text="Session history" Style="{StaticResource DialogTitle}" Margin="0,3,0,0" />
        </DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="275" /><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" IsEnabled="{Binding NotBusy}" Background="#E5E1D3" BorderBrush="#C5C4B4" Padding="7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,9"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Date}" Foreground="#647066" FontSize="12" Margin="0,7,0,4" /><TextBlock Text="{Binding Status}" FontSize="13" Foreground="#735C34" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Heading}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#57675C" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Text="{Binding Counts}" TextWrapping="Wrap" Foreground="#786E55" Margin="0,0,0,18" />
                <ListBox Grid.Row="3" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,9" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="#E3DDCD" /><Setter Property="Margin" Value="0,0,4,0" /></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <ListBox Grid.Row="4" ItemsSource="{Binding Details}" Background="#F9F6EC" BorderBrush="#CCC9BB" Padding="12" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#DED9C8" BorderThickness="0,0,0,1" Padding="0,10,0,14"><StackPanel><DockPanel><TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#786344" FontSize="13" Margin="0,0,14,0" /><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel><TextBlock Text="{Binding Detail}" Foreground="#5B695F" TextWrapping="Wrap" Margin="0,8,0,0" /><controls:SafeMarkdownView Text="{Binding Notes}" Visibility="{Binding HasNotes, Converter={StaticResource Bool}}" FontSize="14" Foreground="#5B695F" Background="Transparent" MaxHeight="150" MinHeight="50" Margin="0,8,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="{Binding Message}" Foreground="#8D4B32" TextWrapping="Wrap" Margin="0,0,0,10" />
            <CheckBox Content="Moments &amp; claps only" IsChecked="{Binding CompactExport}" IsEnabled="{Binding NotBusy}" Margin="0,0,0,12" ToolTip="Clear to export the full session journal and all timing details." /><DockPanel Margin="0,0,0,15"><TextBlock Text="Export folder" Foreground="#657164" Margin="0,0,12,0" VerticalAlignment="Center" /><Button DockPanel.Dock="Right" Command="{Binding FolderCommand}" Style="{StaticResource PaperKey}" Padding="10,6" Margin="12,0,0,0" ToolTip="Choose export folder" AutomationProperties.Name="Choose export folder"><controls:StudioIcon Kind="folder" Width="21" Height="21" /></Button><Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" Style="{StaticResource PaperKey}" Padding="10,6" Margin="12,0,0,0" ToolTip="Open export folder" AutomationProperties.Name="Open export folder"><controls:StudioIcon Kind="folder-open" Width="21" Height="21" /></Button><TextBlock Text="{Binding ExportFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExportFolder}" VerticalAlignment="Center" /></DockPanel>
            <DockPanel><Button Command="{Binding DeleteCommand}" Style="{StaticResource PaperKey}" Padding="10,8" ToolTip="Delete selected session" AutomationProperties.Name="Delete selected session" HorizontalAlignment="Left"><controls:StudioIcon Kind="trash" Width="22" Height="22" /></Button><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding CloseCommand}" IsEnabled="{Binding NotBusy}" Content="Close" Style="{StaticResource PaperKey}" Margin="0,0,12,0" /><Button Command="{Binding CsvCommand}" Content="Export CSV" Style="{StaticResource PaperKey}" Margin="0,0,12,0" /><Button Command="{Binding XlsCommand}" Content="Export XLS" Style="{StaticResource PrimaryKey}" /></StackPanel></DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="{Binding ShowMouseHint, Converter={StaticResource Bool}}"><controls:StudioIcon Kind="mouse" Foreground="#6B726B" Width="14" Height="16" Margin="0,0,6,0" /><TextBlock Text="Use mouse" Foreground="#6B726B" FontSize="12" /></StackPanel>
        </StackPanel>
    </Grid>
</Window>
