<Window x:Class="PodcastHelper.App.ScenarioEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastHelper.App.Controls"
        Title="{Binding Heading}" Width="1080" Height="800" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F1EDDF" Foreground="#29343A" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}" />
        <Style x:Key="EditorIcon" TargetType="Button" BasedOn="{StaticResource PaperKey}"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="0,0,7,0" /></Style>
    </ResourceDictionary></Window.Resources>
    <Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><Border RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource BadgeTilt}" Effect="{StaticResource BadgeShadow}" Width="46" Height="46" VerticalAlignment="Top" Background="{StaticResource AmberCap}" CornerRadius="5" BorderBrush="#B79A64" BorderThickness="1" Margin="0,0,16,0"><controls:StudioIcon Kind="edit" Width="25" Height="25" /></Border><TextBlock Text="{Binding Heading}" Style="{StaticResource DialogTitle}" Margin="0,3,0,0" /></DockPanel>


        <Grid Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding AllowStructureEdits, Converter={StaticResource Bool}}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Scenario name" Foreground="#5A655F" FontSize="13" Margin="0,0,0,6" /><TextBlock Grid.Column="2" Text="Target · minutes : seconds" Foreground="#5A655F" FontSize="13" />
            <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Message}" Foreground="#7B663D" Margin="0,10,0,0" />
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <DockPanel><UniformGrid x:Name="SegmentTools" DockPanel.Dock="Bottom" Rows="1" Margin="0,12,0,0" Visibility="{Binding AllowStructureEdits, Converter={StaticResource Bool}}">
                <Button Style="{StaticResource EditorIcon}" Command="{Binding AddCommand}" ToolTip="Add segment" AutomationProperties.Name="Add segment"><controls:StudioIcon Kind="plus" /></Button><Button Style="{StaticResource EditorIcon}" Command="{Binding RemoveCommand}" ToolTip="Remove selected segment" AutomationProperties.Name="Remove selected segment"><controls:StudioIcon Kind="trash" /></Button><Button Style="{StaticResource EditorIcon}" Command="{Binding UpCommand}" ToolTip="Move segment up" AutomationProperties.Name="Move segment up"><controls:StudioIcon Kind="up" /></Button><Button Style="{StaticResource EditorIcon}" Command="{Binding DownCommand}" ToolTip="Move segment down" AutomationProperties.Name="Move segment down"><controls:StudioIcon Kind="down" /></Button>
            </UniformGrid>
                <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding Selected}" Background="#E5E1D3" BorderBrush="#C6C3B4" Foreground="#34433F" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Duration}" FontFamily="Consolas" Foreground="#7A6D4E" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            </DockPanel>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Segment name" FontSize="13" Foreground="#5A655F" Margin="0,0,0,6" /><TextBlock Grid.Column="2" Text="Minutes : seconds" FontSize="13" Foreground="#5A655F" /><TextBox Grid.Row="1" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Selected.Duration, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></Grid>
                <TextBlock Grid.Row="1" Text="Notes" Foreground="#5A655F" FontSize="13" Margin="0,16,0,6" />
                <TextBox Grid.Row="2" Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="3" Text="Preview" FontSize="13" Foreground="#5A655F" Margin="0,14,0,7" />
                <Border Grid.Row="4" Background="#FFFEF6" BorderBrush="#CECABB" BorderThickness="1" Padding="14,12"><controls:SafeMarkdownView Text="{Binding PreviewMarkdown}" Foreground="#384840" Background="Transparent" /></Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" Foreground="#A04431" TextWrapping="Wrap" Margin="0,0,0,8" /><DockPanel><TextBlock Text="{Binding SaveHint}" TextWrapping="Wrap" Foreground="#6B766D" FontSize="12" VerticalAlignment="Center" MaxWidth="650" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource PaperKey}" Content="Cancel" Command="{Binding CancelCommand}" Margin="16,0,12,0" /><Button Style="{StaticResource PrimaryKey}" Content="Save" Command="{Binding SaveCommand}" MinWidth="90" /></StackPanel></DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="{Binding ShowMouseHint, Converter={StaticResource Bool}}"><controls:StudioIcon Kind="mouse" Foreground="#6B726B" Width="14" Height="16" Margin="0,0,6,0" /><TextBlock Text="Use mouse" FontSize="12" Foreground="#6B726B" /></StackPanel>
        </StackPanel>
    </Grid>
</Window>
